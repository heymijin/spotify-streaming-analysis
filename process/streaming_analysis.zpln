    {
      "text": "%spark.sql\n-- 3) add mnPlayed(minute) column and split 'endTime' column along with endTime/endDate\n\nSELECT artistName,\n       split(endTime, ' ')[0] AS endDate,\n       split(endTime, ' ')[1] AS endTime,\n       msPlayed, \n       ROUND((msPlayed/60000),1) AS mnPlayed, \n       trackName, \n       UniqueID \nFROM df_stream_unique \nLIMIT 20;\n",
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/sql",
        "fontSize": 9,
        "results": {
