      "id": "paragraph_1687581199806_90147152",
      "status": "READY"
    },
    {
      "text": "%python\r\nimport pandas as pd\r\nimport numpy as np\r\nimport requests\r\n\r\nSPOTIFYHOME = \"file:///home/portfolio/spotify\"\r\n\r\n\r\n# read my 1+ StreamingHistory files (depending on how)\r\ndf_stream0 = pd.read_json(f\"{SPOTIFYHOME}/json/StreamingHistory0.json\")\r\ndf_stream1 = pd.read_json(f\"{SPOTIFYHOME}/json/StreamingHistory1.json\")\r\n\r\n# merge streaming dataframes\r\ndf_stream = pd.concat([df_stream0,df_stream1])\r\n\r\n# create a 'uniqueID' for each song by combining the fields 'artistName' and 'trackName'\r\ndf_stream['UniqueID'] = df_stream['artistName']+\":\"+df_stream['trackName']\r\n\r\ndf_stream.head()",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/python",
        "fontSize": 9,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "paragraph_1687583308404_1804756507",
      "status": "READY"
    },
    {
      "text": "%spark.pyspark\nfrom pyspark.sql.functions import *\nfrom pyspark.sql.types import *\n\n# Define the schema for your DataFrame\nschema = StructType([\n    StructField(\"endTime\", LongType(), True),\n    StructField(\"artistName\", StringType(), True),\n    StructField(\"trackName\", StringType(), True),\n    StructField(\"msPlayed\", LongType(), True)\n    \ndf_stream0 = spark.read.schema(schema).json(\"file:///home/portfolio/spotify/json/StreamingHistory0.json\").cache()\n\ndf_stream0.printSchema()\ndf_stream0.show()\n",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/python",
        "fontSize": 9,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "paragraph_1687581612371_843284184",
      "status": "READY"
    },
    {
      "text": "%spark.pyspark\n\n#Define the schema for my JSON data\nschema = StructType([\n    StructField(\"endTime\", TimestampType(), True),\n    StructField(\"artistName\", StringType(), True),\n    StructField(\"trackName\", StringType(), True),\n    StructField(\"msPlayed\", IntegerType(), True)\n])\n\nSPOTIFYHOME = \"file:///home/portfolio/spotify\"\ndf = spark.read.schema(schema).json(f\"{SPOTIFYHOME}/json/StreamingHistory0.json\")\ndf.write.parquet(f\"{SPOTIFYHOME}/parquet/StreamingHistory0.parquet\")  # Save the DataFrame as a Parquet file\n",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
