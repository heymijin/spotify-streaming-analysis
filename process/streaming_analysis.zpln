        "fontSize": 9,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "paragraph_1687581000253_1542915517",
      "status": "READY"
    },
    {
      "text": "%spark.pyspark\n\nSPOTIFYHOME = \"file:///home/portfolio/spotify\"\ndf = spark.read.parquet(f\"{SPOTIFYHOME}/parquet/StreamingHistory0.parquet\")\ndf.show(50)\n\n",
