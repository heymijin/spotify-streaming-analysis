      "status": "READY"
    },
    {
      "text": "%spark.pyspark\n# 6) store final streaming file as parquet @hdfs\ndf_stream.write.parquet('/user/portfolio/spotify/src/parquet')\n",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
