    {
      "text": "%spark.sql\n-- by track\nSELECT trackName,\n       artistName,\n       count(trackName) AS track_count,\n       ROUND(SUM(mnPlayed),1) mnPlayed_track,\n       \n       ROUND(SUM(msPlayed/3600000),1) hrPlayed_track\nFROM\n     my_streaming_only_songs\nGROUP BY trackName, artistName\nORDER BY track_count DESC\nLIMIT 20;\n",
