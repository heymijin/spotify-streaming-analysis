    {
      "text": "%spark.pyspark\n\nfrom pyspark.sql import SparkSession\nfrom pyspark.sql.functions import explode, col, expr\nfrom pyspark.sql.types import StructType",
      "config": {
        "editorSetting": {
          "language": "python",
