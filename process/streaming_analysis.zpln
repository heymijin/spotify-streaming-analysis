    {
      "text": "%spark.pyspark\n# 5) create final df_stream to store as parquet type \ndf_stream = spark.sql(\"\"\"\nSELECT artistName,\n       trackName,\n       endDate,\n       endTime,\n       mnPlayed,\n       msPlayed,\n       UniqueID\nFROM df_stream_fin\n\"\"\")\n\ndf_stream.show(10)",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
