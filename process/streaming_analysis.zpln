    {
      "text": "%spark.pyspark\n# 2) Creating table included UniqueID\nspark.sql(\"SELECT *, CONCAT(artistName, ':', trackName) AS UniqueID FROM df_stream\").createOrReplaceTempView(\"df_stream_unique\")\nprint(\"done\")",
