      "id": "paragraph_1687586942531_674883671",
      "status": "READY"
    },
    {
      "text": "%spark.pyspark\n# show streaming history 0,1 data type\n\n# Sparksession\nspark = SparkSession.builder.getOrCreate()\n\nPATH0=\"/user/portfolio/spotify/src/json/StreamingHistory0.json\"\nPATH1=\"/user/portfolio/spotify/src/json/StreamingHistory1.json\"\n\ndf0 = spark.read.option(\"multiline\",\"true\").json(PATH0) # !!!!!!!!!!\ndf0.createOrReplaceTempView(\"df_streaming0\")\ndf0.printSchema()\n\ndf1 = spark.read.option(\"multiline\", \"true\").json(PATH1) # !!!!!!!!\ndf1.createOrReplaceTempView(\"df_streaming1\")\ndf1.printSchema()\n\n",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/python",
        "fontSize": 9,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "id": "paragraph_1687590235152_1917861144",
      "status": "READY"
    },
    {
      "text": "%spark.pyspark\n# 1)merge streaming dataframes\nspark.sql(\"SELECT * FROM df_streaming0 UNION SELECT * FROM df_streaming1\").createOrReplaceTempView(\"df_stream\")\nprint(\"done\")",
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
